<% layout('layout.eta') %>

<h1>Monthly spending</h1>

<% if (it.error) { %>
  <p class="error">Warning: <%= it.error %></p>
<% } %>

<section>
  <table>
    <thead>
      <tr>
        <th>Month</th>
        <th>Total CHF</th>
        <th>Items</th>
        <th>Top store</th>
        <th>Top category</th>
      </tr>
    </thead>
    <tbody>
      <% it.months.forEach(function (month) { %>
        <tr>
          <td><a href="/spending/<%= month.month %>"><%= month.month %></a></td>
          <td><%= it.formatChf(month.total) %></td>
          <td><%= month.itemCount %></td>
          <td>
            <% if (month.topStore) { %>
              <%= month.topStore.key %> (<%= it.formatChf(month.topStore.value) %>)
            <% } else { %>-<br><% } %>
          </td>
          <td>
            <% if (month.topCategory) { %>
              <%= month.topCategory.key %> (<%= it.formatChf(month.topCategory.value) %>)
            <% } else { %>-<br><% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<% if (it.chartData) { %>
  <section>
    <h2>Monthly spend</h2>
    <div class="chart-container">
      <canvas id="chart-monthly-totals"></canvas>
    </div>
    <script type="application/json" id="data-monthly-totals">
      <%~ it.safeJsonScript(it.chartData.monthlyTotals) %>
    </script>
  </section>

  <section>
    <h2>Spend by category</h2>
    <div class="chart-container">
      <canvas id="chart-category-stack"></canvas>
    </div>
    <script type="application/json" id="data-category-stack">
      <%~ it.safeJsonScript(it.chartData.categoryStack) %>
    </script>
  </section>

  <section>
    <h2>Top stores</h2>
    <div class="chart-container">
      <canvas id="chart-top-stores"></canvas>
    </div>
    <script type="application/json" id="data-top-stores">
      <%~ it.safeJsonScript(it.chartData.topStores) %>
    </script>
  </section>
<% } %>

<% if (it.months.some((m) => m.nonChfWarnings.length > 0)) { %>
  <section class="warnings">
    <h2>Non-CHF entries</h2>
    <ul>
      <% it.months.forEach(function (month) { %>
        <% month.nonChfWarnings.forEach(function (warning) { %>
          <li><%= month.month %>: <%= warning %></li>
        <% }) %>
      <% }) %>
    </ul>
  </section>
<% } %>

<script src="/vendor/chartjs/chart.umd.js"></script>
<script type="module">
  function readData(id) {
    const element = document.getElementById(id);
    if (!element) throw new Error(`Missing chart data element #${id}`);
    return JSON.parse(element.textContent);
  }

  Chart.defaults.responsive = true;
  Chart.defaults.maintainAspectRatio = false;

  new Chart(
    document.getElementById('chart-monthly-totals'),
    {
      type: 'bar',
      data: readData('data-monthly-totals'),
      options: {
        plugins: {
          title: { display: true, text: 'Monthly spend' },
          legend: { display: false },
        },
        scales: {
          x: { title: { display: true, text: 'Month' } },
          y: { title: { display: true, text: 'CHF' } },
        },
      },
    },
  );

  new Chart(
    document.getElementById('chart-category-stack'),
    {
      type: 'bar',
      data: readData('data-category-stack'),
      options: {
        plugins: {
          title: { display: true, text: 'Spend by category' },
          legend: { position: 'bottom' },
        },
        scales: {
          x: { title: { display: true, text: 'Month' }, stacked: true },
          y: { title: { display: true, text: 'CHF' }, stacked: true },
        },
      },
    },
  );

  new Chart(
    document.getElementById('chart-top-stores'),
    {
      type: 'doughnut',
      data: readData('data-top-stores'),
      options: {
        plugins: {
          title: { display: true, text: 'Top stores' },
          legend: { position: 'bottom' },
        },
      },
    },
  );
</script>
